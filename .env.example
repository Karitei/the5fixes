# Copy to .env and fill in. NEVER commit .env — it is in .gitignore.
# Generate a real secret with:  openssl rand -base64 48
JWT_SECRET=

DB_NAME=starterkit
DB_USERNAME=starterkit
DB_PASSWORD=starterkit
DB_URL=jdbc:postgresql://localhost:5432/starterkit

CORS_ORIGINS=http://localhost:4200

# Optional: creates the first ADMIN on startup, then remove these.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Administrator
